# Copier ce fichier en .env (dans app/backend) et l'adapter.
# Le fichier .env n'est JAMAIS versionné : il contient des secrets.

# Base PostgreSQL installée sur votre poste
DATABASE_URL=postgresql+psycopg://qatag:VOTRE_MOT_DE_PASSE@localhost:5432/qatag

# Clé de signature des sessions : 32 caractères minimum, propre à votre installation.
# Pour en générer une : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Durée d'une session de connexion, en heures
DUREE_SESSION_HEURES=8

# Inscription libre : false = après le premier compte, seul un administrateur
# crée les comptes (page Utilisateurs). Ne passer à true qu'en connaissance de cause.
INSCRIPTION_LIBRE=false

# Connexion : échecs tolérés sur la fenêtre (en minutes), par e-mail puis par
# adresse IP. Au-delà, la connexion est refusée jusqu'à la fin de la fenêtre.
CONNEXION_ESSAIS_MAX=5
CONNEXION_ESSAIS_MAX_IP=20
CONNEXION_FENETRE_MINUTES=15

# Clés d'API des fournisseurs IA (remplir uniquement celles que vous utilisez).
# Le choix du fournisseur et du modèle se fait ensuite dans l'application,
# page Configuration (rôle Administrateur).
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (modèle local, sans clé) — adresse par défaut d'Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# Longueur maximale d'une réponse IA, en tokens. Laisser 0 pour la valeur
# prévue par fournisseur (DeepSeek 32768, OpenAI 16384, Mistral 16384,
# Anthropic 32000, Ollama 8192). À augmenter si l'appli signale une réponse
# tronquée, sans dépasser la limite de votre modèle.
IA_MAX_TOKENS=0

# Sauvegardes (python -m qatag.sauvegarde) : nombre de sauvegardes conservées,
# dossier (par défaut app\sauvegardes) et dossier bin de PostgreSQL si pg_dump
# n'est pas trouvé, par exemple : PG_BIN=C:\Program Files\PostgreSQL\16\bin
SAUVEGARDES_CONSERVEES=14
# DOSSIER_SAUVEGARDES=
PG_BIN=
