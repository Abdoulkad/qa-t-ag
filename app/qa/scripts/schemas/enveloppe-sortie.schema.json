{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qa-t-ag/contrats/enveloppe-sortie.schema.json",
  "title": "Enveloppe de sortie d'agent (SFD §6.2 + §10)",
  "description": "Contrat de sortie d'un agent QA-T-AG. Le statut est restreint aux valeurs canoniques (DEF-001) ; attempt_id est exigé pour l'idempotence (DEF-005, §10).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "task_id",
    "attempt_id",
    "agent_id",
    "agent_version",
    "status",
    "artifact_path",
    "input_fingerprints",
    "warnings",
    "errors",
    "metrics",
    "human_approval_required"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "campaign_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "pattern": "^AG-[0-9]{2}$" },
    "agent_version": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["OK", "A_CLARIFIER", "EN_ATTENTE", "ERREUR", "BLOQUE"]
    },
    "artifact_path": { "type": "string", "minLength": 1 },
    "input_fingerprints": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_seconds", "model_calls", "cost"],
      "properties": {
        "duration_seconds": { "type": "number", "minimum": 0 },
        "model_calls": { "type": "integer", "minimum": 0 },
        "cost": { "type": ["number", "null"] }
      }
    },
    "human_approval_required": { "type": "boolean" }
  }
}
