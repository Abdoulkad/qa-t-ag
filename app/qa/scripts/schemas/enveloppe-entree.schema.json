{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qa-t-ag/contrats/enveloppe-entree.schema.json",
  "title": "Enveloppe d'entrée d'agent (SFD §6.1)",
  "description": "Contrat minimal d'entrée d'un agent QA-T-AG. Champs obligatoires : schema_version, campaign_id, project_id, agent_id, task_id, input_artifacts, approved_scope, human_gate_state, limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "project_id",
    "agent_id",
    "task_id",
    "input_artifacts",
    "approved_scope",
    "human_gate_state",
    "limits"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "campaign_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "pattern": "^AG-[0-9]{2}$" },
    "task_id": { "type": "string", "minLength": 1 },
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "path", "sha256", "version"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "approved_scope": { "type": "string", "minLength": 1 },
    "human_gate_state": { "type": "string", "minLength": 1 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_duration_seconds", "max_model_calls", "max_cost"],
      "properties": {
        "max_duration_seconds": { "type": "integer", "minimum": 0 },
        "max_model_calls": { "type": "integer", "minimum": 0 },
        "max_cost": { "type": ["number", "null"] }
      }
    }
  }
}
